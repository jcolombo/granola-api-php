{
  "name": "jcolombo/granola-api-php",
  "description": "PHP SDK for the Granola meeting-notes API, with a framework-agnostic webhook parser and signature verifier",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/jcolombo/granola-api-php",
  "authors": [
    {
      "name": "Joel Colombo",
      "email": "jc-dev@360psg.com",
      "homepage": "https://360psg.com"
    }
  ],
  "support": {
    "issues": "https://github.com/jcolombo/granola-api-php/issues",
    "source": "https://github.com/jcolombo/granola-api-php"
  },
  "keywords": [
    "granola",
    "granola.ai",
    "meeting notes",
    "transcripts",
    "webhooks",
    "standard webhooks",
    "api",
    "sdk",
    "rest",
    "php"
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.8",
    "adbario/php-dot-notation": "^3.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Jcolombo\\GranolaApiPhp\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jcolombo\\GranolaApiPhp\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:live": "./tests/validate",
    "test:live:dry-run": "./tests/validate --dry-run",
    "test:live:verbose": "./tests/validate --verbose"
  },
  "config": {
    "sort-packages": true
  }
}
